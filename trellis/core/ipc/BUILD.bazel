load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "named_resource_registry",
    hdrs = ["named_resource_registry.hpp"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "utils",
    hdrs = ["utils.hpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//trellis/core:core_config",
    ],
)

cc_library(
    name = "in_process_bus",
    srcs = ["in_process_bus.cpp"],
    hdrs = ["in_process_bus.hpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//trellis/core:core_event_loop",
        "//trellis/core/ipc/shm:shm_file",
        "@asio",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "**/*.hpp",
        ],
        exclude = ["**/test/**"],
    ),
    visibility = ["//trellis:__pkg__"],
)
